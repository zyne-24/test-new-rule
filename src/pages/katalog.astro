    { id: 6, name: 'Polo Shirt Lacoste Pique Bordir', category: 'Polo', price: 'Rp 95.000', img: 'https://images.unsplash.com/photo-1625910513418-7c471887e452?auto=format&fit=crop&q=80&w=600' },
    { id: 7, name: 'Parka Waterproof Outerwear', category: 'Jaket', price: 'Rp 290.000', img: 'https://images.unsplash.com/photo-1544441893-675973e31985?auto=format&fit=crop&q=80&w=600' },
    { id: 8, name: 'Zip-up Fleece Hoodie Regular', category: 'Hoodie', price: 'Rp 185.000', img: 'https://images.unsplash.com/photo-1509967419530-da38b4704bc6?auto=format&fit=crop&q=80&w=600' },
    { id: 9, name: 'Kemeja Kerja Lapangan (PDL)', category: 'Seragam', price: 'Rp 155.000', img: 'https://images.unsplash.com/photo-1602810318383-e386cc2a3ccf?auto=format&fit=crop&q=80&w=600' },
    { id: 10, name: 'Kaos Polos Cotton Combed 30s', category: 'Kaos', price: 'Rp 65.000', img: 'https://images.unsplash.com/photo-1583743814966-8936f5b7be1a?auto=format&fit=crop&q=80&w=600' },
    { id: 11, name: 'Coach Jacket Windbreaker', category: 'Jaket', price: 'Rp 210.000', img: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&q=80&w=600' },
    { id: 12, name: 'Crewneck Sweatshirt Minimalist', category: 'Hoodie', price: 'Rp 170.000', img: 'https://images.unsplash.com/photo-1620799140408-edc6dcb6d633?auto=format&fit=crop&q=80&w=600' },
    { id: 13, name: 'Seragam Batik Korporat Premium', category: 'Seragam', price: 'Rp 145.000', img: 'https://images.unsplash.com/photo-1598033129183-c4f50c736f10?auto=format&fit=crop&q=80&w=600' },
    { id: 14, name: 'Kaos Raglan Event & Gathering', category: 'Kaos', price: 'Rp 80.000', img: 'https://images.unsplash.com/photo-1529374255404-311a2a4f1fd9?auto=format&fit=crop&q=80&w=600' },
