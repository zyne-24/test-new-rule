    { id: 3, name: 'Seragam PDH Kantor Eksekutif', category: 'Seragam', price: 'Rp 180.000', img: 'https://images.unsplash.com/photo-1594938298603-c8148c4dae35?auto=format&fit=crop&q=80&w=600' },
