    { id: 16, name: 'Rompi Safety Lapangan (Vest)', category: 'Jaket', price: 'Rp 130.000', img: 'https://images.unsplash.com/photo-1576566588028-4147f3842f27?auto=format&fit=crop&q=80&w=600' },
    { id: 17, name: 'Jersey Olahraga Sublimasi Fullprint', category: 'Kaos', price: 'Rp 110.000', img: 'https://images.unsplash.com/photo-1517466787929-bc90951d0974?auto=format&fit=crop&q=80&w=600' },
    { id: 18, name: 'Jas Laboratorium / Medis', category: 'Seragam', price: 'Rp 125.000', img: 'https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&q=80&w=600' },
    { id: 19, name: 'Topi Baseball Custom Bordir', category: 'Aksesoris', price: 'Rp 35.000', img: 'https://images.unsplash.com/photo-1588850561407-ed78c282e89b?auto=format&fit=crop&q=80&w=600' },
    { id: 20, name: 'Tote Bag Kanvas Custom Sablon', category: 'Aksesoris', price: 'Rp 25.000', img: 'https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&q=80&w=600' }
];
---
<Layout title="Katalog 20 Produk Konveksi — Konveksi Nusantara">
    <div class="max-w-7xl mx-auto px-6 py-16" x-data="{ selectedCategory: 'Semua' }">
        <div class="text-center mb-12">
            <span class="text-xs uppercase tracking-widest text-luxury-800 font-semibold mb-3 block">Katalog Lengkap</span>
            <h1 class="text-4xl sm:text-6xl font-serif mb-4">20 Pilihan Produk Konveksi Premium</h1>
            <p class="text-luxury-800 font-light max-w-xl mx-auto">Standar jahitan rapi, bahan teruji, dan kontrol kualitas ketat untuk setiap pesanan.</p>
        </div>

        <!-- Filter Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
            <template x-for="cat in ['Semua', 'Jaket', 'Hoodie', 'Seragam', 'Kaos', 'Almamater', 'Polo', 'Aksesoris']">
                <button @click="selectedCategory = cat"
                        :class="selectedCategory === cat ? 'bg-luxury-900 text-white' : 'bg-white text-luxury-900 border border-luxury-200 hover:bg-luxury-100'"
                        class="px-6 py-2.5 rounded-full text-sm font-medium transition"
                        x-text="cat"></button>
            </template>
        </div>

        <!-- Products Grid (20 Items) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
            {products.map((p) => (
                <div x-show="selectedCategory === 'Semua' || selectedCategory === '{p.category}'"
                     class="bg-white rounded-3xl p-5 border border-luxury-200 shadow-sm hover:shadow-xl transition flex flex-col justify-between group">
                    <div>
                        <div class="relative w-full h-64 bg-luxury-100 rounded-2xl overflow-hidden mb-5">
                            <img src="{p.img}" alt="{p.name}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                            <span class="absolute top-3 right-3 px-3 py-1 bg-white/90 backdrop-blur-md rounded-full text-xs font-semibold">{p.category}</span>
                        </div>
                        <h3 class="font-serif text-xl mb-2 text-luxury-900">{p.name}</h3>
                    </div>
                    <div class="pt-4 border-t border-luxury-200 flex items-center justify-between mt-4">
                        <div>
                            <span class="text-xs text-luxury-800 block">Estimasi Harga</span>
                            <span class="font-bold text-luxury-900">{p.price}</span>
                        </div>
                        <a href="https://wa.me/6281234567890?text=Halo,%20saya%20tertarik%20pesan%20{encodeURIComponent(p.name)}" target="_blank" class="px-4 py-2 bg-luxury-900 text-white text-xs font-medium rounded-full hover:bg-black transition">Pesan</a>
                    </div>
                </div>
            ))}
        </div>
    </div>
</Layout>
